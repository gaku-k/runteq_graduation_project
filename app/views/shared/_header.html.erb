<div class="header">
  <h3><%= link_to "My Page", user_path(current_user) %></h3>
  <h3><%= link_to "Review List", posts_path %></h3>
  <h3><%= link_to "Olive Oil List", products_path %></h3>

  <div class="header-right-menu">
    <div>
      <%= link_to "利用規約", "#" %> |
      <%= link_to "プライバシーポリシー", "#" %> |
      <%= link_to "お問い合わせ", "#" %>
    </div>
    <div>
      <!-- ure_signed_in?メソッド: ユーザーがサインイン状態だとtrue, ログアウト状態だとfalse -->
      <!-- 余談だがadmin_signed_in? でも動くとかなんとか -->
      <% if user_signed_in?  %>
        <%= button_to "ログアウト", destroy_user_session_path, method: :delete, date: { turbo: false } %>
      <% else %>
        <%= button_to "ログイン", new_user_session_path %>
      <% end %>
    </div>
  </div>
</div>