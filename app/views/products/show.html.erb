<div class="my-card">
  <h1>商品詳細</h1>

  <ul>
    <li>
      <!-- 画像エリア -->
      <div class="image-section">
        <%= render "products/images", product: @product %>
      </div>

      <!-- 情報エリア -->
      <div>
        <!-- レーダーチャート -->
        <div>
          <h2><%= @product.name %></h2>
          <div class="new-pentagon-radar-chart-container">
            <%= render partial: "products/radar_chart", locals: { product: @product } %>
          </div>
        </div>

        <!-- 商品詳細情報 -->
        <div class="product-detail-section">
          <h2 class="italic-title">Product Info</h2>
          <ul class="product-detail-list">
            <li>
              <span class="detail-label">原産国</span>
              <span class="detail-value"><%= @product.country_of_origin %></span>
            </li>
            <li>
              <span class="detail-label">使用オリーブ品種</span>
              <span class="detail-value">
                <% @product.olive_varieties.each do |variety| %>
                  <span class="tag"><%= variety.name %></span>
                <% end %>
              </span>
            </li>
            <li>
              <span class="detail-label">容量(ml)</span>
              <span class="detail-value"><%= @product.volume %></span>
            </li>
            <li>
              <span class="detail-label">参考価格(円)</span>
              <span class="detail-value"><%= @product.reference_price %></span>
            </li>
          </ul>
        </div>
      </div>

    </li>
  </ul>

  <div style="text-align: right;">
    <%= link_to "編集する", edit_product_path(@product)%>
  </div>
  <hr>
  <h3>あなたの評価</h3>

  <%= form_with(model: [@product, @product_rating], local: true) do |f| %>
    <div>
      <%= f.label :sweet, "甘さ" %>
      <%= f.number_field :sweet, in: 1..5 %>
    </div>

    <div>
      <%= f.label :fruity, "果実感" %>
      <%= f.number_field :fruity, in: 1..5 %>
    </div>

    <div>
      <%= f.label :green, "青い" %>
      <%= f.number_field :green, in: 1..5 %>
    </div>

    <div>
      <%= f.label :spicy, "辛み" %>
      <%= f.number_field :spicy, in: 1..5 %>
    </div>

    <div>
      <%= f.label :bitter, "苦み" %>
      <%= f.number_field :bitter, in: 1..5 %>
    </div>

    <!-- persisted? :ActiveRecordのメソッドでオブジェクトがDBに存在すればtrue,新規ならfalse -->
    <!-- 条件式 ? 真の場合の値 : 偽の場合の値 で、1行のif文 -->
    <%= f.submit @product_rating.persisted? ? "評価を更新" : "評価を登録" %>
  <% end %>
</div>