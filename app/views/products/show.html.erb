<div class="my-card">
  <h1>商品詳細</h1>

  <ul>
    <li>
      <!-- 画像エリア -->
      <div class="image-section">
        <%= render "products/images", product: @product %>
      </div>

      <!-- 情報エリア -->
      <div>
        <!-- レーダーチャート -->
        <div>
          <h2><%= @product.name %></h2>
          <div class="new-pentagon-radar-chart-container">
            <%= render partial: "products/radar_chart", locals: { product: @product } %>
          </div>
        </div>

        <!-- 商品詳細情報 -->
        <div class="product-detail-section">
          <h2 class="italic-title">Product Info</h2>
          <ul class="product-detail-list">
            <li>
              <span class="detail-label">原産国</span>
              <span class="detail-value"><%= @product.country_of_origin %></span>
            </li>
            <li>
              <span class="detail-label">使用オリーブ品種</span>
              <span class="detail-value">
                <% @product.olive_varieties.each do |variety| %>
                  <span class="tag"><%= variety.name %></span>
                <% end %>
              </span>
            </li>
            <li>
              <span class="detail-label">容量(ml)</span>
              <span class="detail-value"><%= @product.volume %></span>
            </li>
            <li>
              <span class="detail-label">参考価格(円)</span>
              <span class="detail-value"><%= @product.reference_price %></span>
            </li>
          </ul>
        </div>
      </div>

    </li>
  </ul>
</div>