<div class="my-card">

  <%= render "shared/back_link" %>

  <%
    all_errors = @product.errors.full_messages
    all_errors += @product_rating.errors.full_messages if @product_rating.present?
  %>
  <% if all_errors.any? %>
    <div id="error_explanation">
      <!-- pluralizeを(単数、複数を切り替えてくれる)使って、発生したエラーの総数を表示 -->
      <h2><%= pluralize(all_errors.count, "error") %> が発生しました:</h2>
      <ul>
        <!-- @post のバリデーションに基づいて、Rilsがエラーを生成 -->
        <% all_errors.uniq.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <ul>
    <li>
      <!-- 画像エリア -->
      <div class="image-section">
        <%= render "products/images", product: @product %>
      </div>

      <div class="chart-post-container">
        <div class="show-flavorchart-container">
          <%= render partial: "products/flavor_chart", locals: { product: @product, average_ratings: @product.average_ratings, ratings_count: @product.ratings_count } %>
        </div>
        <div  class="post-from-product">
          <span class="post-text">この商品でPostする</span>
          <div>
            <%= link_to new_product_post_path(@product, back_to: request.fullpath),
              class: "create-a-post" do %>
              <i class="fas fa-pen"></i>
            <% end %>
          </div>
        </div>
      </div>

      <!-- 商品詳細情報 -->
      <div class="product-detail-section">
        <h2>Product Info</h2>          
        <ul class="product-detail-list">
          <li>
            <span class="detail-label">商品名</span>
            <span class="detail-value"><%= @product.name %></span>
          </li>
          <li>
            <span class="detail-label">原産国</span>
            <span class="detail-value"><%= @product.country_of_origin %></span>
          </li>
          <li>
            <span class="detail-label">使用オリーブ品種</span>
            <span class="detail-value">
              <% @product.olive_varieties.each do |variety| %>
                <span><%= variety.name %></span>
              <% end %>
            </span>
          </li>
          <li>
            <span class="detail-label">容量(ml)</span>
            <span class="detail-value"><%= @product.volume %></span>
          </li>
          <li>
            <span class="detail-label">参考価格(円)</span>
            <span class="detail-value"><%= @product.reference_price %></span>
          </li>
        </ul>
      </div>

    </li>
  </ul>

  <div style="text-align: right; padding-right: 5px;">
    <% unless @product.draft? %>
      <% if current_user&.admin? %>
        <%= link_to "削除", product_path(@product), 
          method: :delete,
          data: {
            turbo_method: :delete,
            turbo_confirm: "削除しますか？"
          } %>
      <% end %>

      <%= link_to edit_product_path(@product, back_to: request.fullpath) do%>
        <div class="icon-text-container">
          <i class="fa-solid fa-gears"></i>
          <span>編集する</span>
        </div>
      <% end %>

    <% else %>
      <span class="draft-tag">申請中</span>
    <% end %>
  </div>
  <hr>

  <h3 class="bold-title">あなたの評価を登録！</h3>
  <p class="notice">
    すべての項目（甘さ・果実感・苦味・辛味・香り）に評価をつけてください。5つの値が揃っていない場合は登録できません。
  </p>

  <%= form_with(model: [@product, @product_rating], local: true) do |f| %>
    <!-- ProductRating値について各ページでバリデーションを区別するための処理 -->
    <%= f.hidden_field :product_page_rating, value: 'true' %>

    <div class="rating-field">
      <%= f.label :sweet, "甘さ", class: "rating-label" %>
      <div id="sweet-rating"></div>
      <%= f.hidden_field :sweet %>
    </div>

    <div class="rating-field">
      <%= f.label :fruity, "果実感", class: "rating-label" %>
      <div id="fruity-rating"></div>
      <%= f.hidden_field :fruity %>
    </div>

    <div class="rating-field">
      <%= f.label :green, "青い", class: "rating-label" %>
      <div id="green-rating"></div>
      <%= f.hidden_field :green %>
    </div>

    <div class="rating-field">
      <%= f.label :spicy, "辛み", class: "rating-label" %>
      <div id="spicy-rating"></div>
      <%= f.hidden_field :spicy %>
    </div>

    <div class="rating-field">
      <%= f.label :bitter, "苦み", class: "rating-label" %>
      <div id="bitter-rating"></div>
      <%= f.hidden_field :bitter %>
    </div>

    <div class="actions title-margin btn-margin">
      <!-- persisted? :ActiveRecordのメソッドでオブジェクトがDBに存在すればtrue,新規ならfalse -->
      <!-- 条件式 ? 真の場合の値 : 偽の場合の値 で、1行のif文 -->
      <%= f.submit @product_rating.persisted? ? "更新" : "登録" %>
    </div>
  <% end %>

  <div>コメント</div>
  <%= render "comments/form", commentable: @product %>

  <% @comments.each do |comment| %>
    <%= render "comments/comment",
      comment: comment,
      commentable: @product
    %>
  <% end %>
</div>