<div class="my-card">
  <h1>商品情報登録フォーム</h1>

  <%= form_with(model: @product, local: true) do |f| %>

    <% if @product.errors.any? %>
      <div id="error_explanation">
        <!-- pluralizeを(単数、複数を切り替えてくれる)使って、発生したエラーの総数を表示 -->
        <h2><%= pluralize(@product.errors.count, "error") %> が発生しました:</h2>
        <ul>
          <!-- @product のバリデーションに基づいて、Rilsがエラーを生成 -->
          <% @product.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="field input-group">
      <%= f.label :product_name do %>
        商品名<span class="required-star">*</span>
      <% end %>
      <%= f.text_field :name %>
    </div>

    <p class="italic-title">Flavor Chart<span class="required-star">*</span></p>
    <div>
      <!-- 甘み -->
      <div class="rating-field">
        <%= f.label :sweet_rating, "甘み", class: "rating-label" %>
        <!-- この空の `div` に、外部ライブラリ(js)が動的にHTML要素を生成します -->
        <div id="sweet-rating"></div>
        <!-- ユーザーが上記の `div` で星などを操作した際、その評価結果（数値）を実際に保存するための隠された入力欄 -->
        <%= f.hidden_field :sweet_rating %>
      </div>

      <!-- 果実感 -->
      <div class="rating-field">
        <%= f.label :fruity_rating, "果実感", class: "rating-label" %>
        <div id="fruity-rating"></div>
        <%= f.hidden_field :fruity_rating %>
      </div>

      <!-- 青い -->
      <div class="rating-field">
        <%= f.label :green_rating, "青い" , class: "rating-label" %>
        <div id="green-rating"></div>
        <%= f.hidden_field :green_rating %>
      </div>

      <!-- 辛み -->
      <div class="rating-field">
        <%= f.label :spicy_rating, "辛み" , class: "rating-label" %>
        <div id="spicy-rating"></div>
        <%= f.hidden_field :spicy_rating %>
      </div>

      <!-- 苦み -->
      <div class="rating-field">
        <%= f.label :bitter_rating, "苦み" , class: "rating-label" %>
        <div id="bitter-rating"></div>
        <%= f.hidden_field :bitter_rating %>
      </div>
    </div>

    <div class="field">
      <%= f.label :images, "画像を追加" %><br>
      <!-- multiple: true は複数選択の許可 -->
      <%= f.file_field :images, multiple: true %>
    </div>

    <ul>
      <li>
        <%= f.label :country_of_origin, "原産国" %>
        <%= f.text_field :country_of_origin %>
      </li>
      <li>
        <%= f.label :volume, "容量" %>
        <%= f.text_field :volume %>
      </li>
      <li>
        <%= f.label :reference_price, "参考価格" %>
        <%= f.number_field :reference_price %>
      </li>
    </ul>

    <div data-controller="olive-variety-modal">
      <button type="button" data-action="click->olive-variety-modal#open" class="btn">品種を選択</button>

      <!-- モーダル本体 -->
      <div data-olive-variety-modal-target="content" class="hidden">
        <div>
          <h3>オリーブの品種を選択</h3>

          <% @olive_varieties.each do |v| %>
            <div>
              <%= check_box_tag "product[olive_variety_ids][]", v.id, false, id: "v_#{v.id}" %>
              <%= label_tag "v_#{v.id}", v.name %>
            </div>
          <% end %>

          <button type="button" data-action="click->olive-variety-modal#close">閉じる</button>
        </div>
      </div>
    </div>

    <!-- 新しい品種を追加 -->
    <div data-controller="add-variety">
      <%= label_tag "new_olive_variety_name", "新しい品種" %>

      <!-- 入力欄をまとめる領域 -->
      <div data-add-variety-target="fields">
        <div class="variety-field mb-2 flex items-center gap-2">
          <%= text_field_tag "new_olive_variety_name[]", nil, class: "border p-1 rounded w-full" %>
          <button type="button" data-action="click->add-variety#removeField" class="text-red-500">−</button>
        </div>
      </div>

      <!-- テンプレート（非表示） -->
      <template data-add-variety-target="template">
        <div class="variety-field mb-2 flex items-center gap-2">
          <%= text_field_tag "new_olive_variety_name[]", nil, class: "border p-1 rounded w-full" %>
          <button type="button" data-action="click->add-variety#removeField" class="text-red-500">−</button>
        </div>
      </template>

      <!-- 追加ボタン -->
      <button type="button" data-action="click->add-variety#addField" class="text-blue-600 font-bold mt-2">
        ＋ 品種を追加
      </button>
    </div>
  <% end %>
</div>