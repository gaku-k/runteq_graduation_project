<div class="my-card">
  <h2 class="w-full max-w-md text-center">
    Sign up
  </h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "users/shared/error_messages", resource: resource %>

    <br>
    <div class="field">
      <%= f.label "ユーザー名" %><br>
      <%= f.text_field :name, autofocus: true, class: "w-full" %>
    </div>

    <br>
    <div class="field">
      <%= f.label :email %><br />
      <%= f.email_field :email, autocomplete: "email", class: "w-full" %>
    </div>

    <br>
    <div class="field">
      <%= f.label :password %>
      <% if @minimum_password_length %>
      <em>(<%= @minimum_password_length %> characters minimum)</em>
      <% end %><br />
      <%= f.password_field :password, autocomplete: "new-password", class: "w-full" %>
    </div>

    <br>
    <div class="field">
      <%= f.label :password_confirmation %><br />
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full" %>
    </div>

    <br>
    <div class="actions w-full max-w-md text-center">
      <%= f.submit "Sign up", class: "w-full" %>
    </div>
  <% end %>

  <%= render "users/shared/links" %>
</div>  
