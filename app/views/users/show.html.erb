<%= render "shared/floating_button" %>
<%= render "shared/admin_floating_button" %>

<div class="my-card">
  <h1 class="title-l">My Page</h1>

  <div class="my-page-container">
    <div>
      <% if @user.avatar.attached? %>
        <%= image_tag @user.avatar.variant(resize_to_fill: [300, 300]),
          class: "rounded-full user-avatar"%>
      <% else %>
        <%= image_tag "44775.jpg",
          class: "rounded-full user-avatar" %>
      <% end %>
    </div>

    <div class="user-info">
      <div>
        <h2>ユーザー名</h2>
        <%= @user.name %>
      </div>

      <div>
        <h2>ID</h2>
        <%= @user.public_id %>
      </div>
    </div>
  </div>

  <div class="profile-link-container">
    <%= link_to "プロフィール編集", edit_user_registration_path, class: "edit-profile-button" %>
  </div>

  <h2 class="italic-title">My Posts</h2>
  <hr>
  <div class="posts-list">
    <% @user.posts.each do |post| %>
      <div class="avatar-post-wrapper">
        <div>
          <% if post.user.avatar.attached? %>
            <%= image_tag post.user.avatar.variant(resize_to_fill: [300, 300]),
              class: "rounded-full user-avatar-s"%>
          <% else %>
            <%= image_tag "44775.jpg",
              class: "rounded-full user-avatar-s" %>
          <% end %>
        </div>

      <div class="post-item">
        <%= link_to post_path(post), class: "post-card-link" do %>
          <div class="image-section">
            <%= render "posts/images", post: post %>
          </div>

          <div class="chart-review-wrapper">
            <% if post.product.present? %>
              <!-- 1ユーザー1商品1評価値を実現するためにProductRatingsテーブルにはpost_idがない。つなりPostと直接的なアソシエーションがない -->
              <% product_rating = post.product.product_ratings.find_by(user: post.user) %>
              <% if product_rating.present? %>
                <div class="chart-section">
                  <h2><%= post.product_name %></h2>
                  <%= render partial: "posts/triangle_chart", locals: { post_id: post.id, product_rating: product_rating } %>
                </div>
              <% end %>
            <% end %>   

            <div class="review-section">
              <p><%= post.body %></p>
            </div>
          </div>
        <% end %>
      </div>
      </div>
    <% end %>
  </div>
</div>
