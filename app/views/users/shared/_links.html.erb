<div class="text-center">
  <%- if devise_mapping.omniauthable? %>
  <div class="oauth-buttons">
    <%- resource_class.omniauth_providers.each do |provider| %>
      <%= button_to "Googleアカウントでログイン", 
        omniauth_authorize_path(resource_name, provider), 
        method: :post, 
        form: { data: { turbo: false } } %>
    <% end %>
  </div>
  <% end %>

  <%- if controller_name != 'sessions' %>
  <!-- class: "text-link-green"はtailwind.config.jsで色を定義している-->
    <span>既にアカウントをお持ちですか？<%= link_to "ログインページに戻る", new_session_path(resource_name), style: "color: #7D9D76;" %></span><br />
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <span>アカウントが未登録ですか？<%= link_to "アカウントの作成", new_registration_path(resource_name), style: "color: #7D9D76;" %></span><br />
  <% end %>

  <%#- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <!-- <span>パスワードを忘れた方は<%= link_to "こちら", new_password_path(resource_name), style: "color: #7D9D76;" %></span><br /> -->
  <%# end %>
</div>

<%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
  <%= link_to "Didn't receive confirmation instructions?", new_confirmation_path(resource_name) %><br />
<% end %>

<%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
  <%= link_to "Didn't receive unlock instructions?", new_unlock_path(resource_name) %><br />
<% end %>

</div>