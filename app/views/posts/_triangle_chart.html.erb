<div class="chart-container">
  <canvas id="rating-chart-<%= post_id %>"></canvas>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const ctx = document.getElementById('rating-chart-<%= post_id %>').getContext('2d');
  
  new Chart(ctx, {
    type: 'radar',
    data: {
      labels: ['香り', '味', '価格'],
      datasets: [{
        label: 'Triangle Chart', 
        data: [
          <%= product_rating.aroma %>,
          <%= product_rating.taste %>,
          <%= product_rating.price %>
        ],
        fill: true,
        backgroundColor: 'rgba(125, 157, 118, 0.2)',
        borderColor: 'rgba(125, 157, 118, 1)',
        pointBackgroundColor: 'rgba(125, 157, 118, 1)'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: true,
          labels: {
            usePointStyle: false,  // 左の四角を非表示
            boxWidth: 0,           // 余白も消す
            font: {
              size: 14,            // 文字サイズ
              style: 'italic'      // 斜体
            }
          }
        }
      },
      scales: {
        r: { min: 0, max: 5, ticks: { stepSize: 1 } }
      }
    }
  });
});
</script>