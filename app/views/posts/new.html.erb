<div class="my-card">

  <%= render "shared/back_link" %>

  <%= form_with(model: @post, local: true) do |f| %>
    <!-- ProductRating値について各ページでバリデーションを区別するための処理 -->
    <%= f.hidden_field :product_page_rating, value: 'false' %>

    <%
      all_errors = @post.errors.full_messages
      all_errors += @product_rating.errors.full_messages if @product_rating.present?
    %>
    <% if all_errors.any? %>
      <div id="error_explanation" class="form-errors">
        <h2><%= t("errors.header", count: all_errors.count) %></h2>
        <ul>
          <!-- @post のバリデーションに基づいて、Rilsがエラーを生成 -->
          <% all_errors.uniq.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- アイコンとフォームを横並びにする -->
    <ul class="avatar-post-wrapper">
      <li class="avatar-s-item">
        <% if current_user.avatar.attached? %>
          <%= image_tag current_user.avatar.variant(resize_to_fill: [300, 300]),
            class: "rounded-full user-avatar-s"%>
        <% else %>
          <%= image_tag "44775.jpg",
            class: "rounded-full user-avatar-s" %>
        <% end %>
      </li>

      <li class="new-post-item">
        <!-- タイトル と ボタンを横並びにする狙い -->
        <div class="post-header">
          <h1 class="title-l">Write a post</h1>
          <div class="actions">
            <%= f.submit "Post" %>
          </div>
        </div>

        <!-- productに紐づいていない場合、商品名の欄を非表示にする -->
        <% if @post.product_id.present? %>
          <div class="field input-group">
            <%= f.label :product_name do %>
              商品名<span class="required-star">*</span>
            <% end %>
            <!-- html属性readonlyをつけると「表示されるが値は編集不可」になる -->
            <!-- 入力内容確認フォームなどでreadonly: trueがよく使われるとのこと -->
            <%= f.text_field :product_name, readonly: @post.product_name.present? %>
          </div>
        <% end %>
        <!-- 隠しフォームでidを送り、showページでリンク化する -->
        <%= f.hidden_field :product_id if @post.product_id.present?%>

        <% if @product.present? %>
          <div class="triangle-chart-input">
            <p class="italic-title">Triangle Chart<span class="required-star">*</span></p>

            <%= f.fields_for :product_rating, @product_rating do |r| %>

              <!-- 香り -->
              <div class="rating-field">
                <span class="rating-label">香りの印象</span>
                <!-- この空の `div` に、外部ライブラリ(js)が動的にHTML要素を生成します -->
                <div id="aroma-rating"></div>
                <!-- ユーザーが上記の `div` で星などを操作した際、その評価結果（数値）を実際に保存するための隠された入力欄 -->
                <%= r.hidden_field :aroma %>
              </div>

              <!-- 味 -->
              <div class="rating-field">
                <span class="rating-label">味わいの満足度</span>
                <div id="taste-rating"></div>
                <%= r.hidden_field :taste %>
              </div>

              <!-- 価格 -->
              <div class="rating-field">
                <span class="rating-label">価格の満足度</span>
                <div id="price-rating"></div>
                <%= r.hidden_field :price %>
              </div>
            <% end %>
          </div>
        <% end %>

        <div class="field input-group vertical-group">
          <%= f.text_area :body, rows: 6 %>
        </div>

        <div class="field">
          <%= f.label :images, "画像を追加" %><br>
          <!-- multiple: true は複数選択の許可 -->
          <%= f.file_field :images, multiple: true %>
        </div>

        <!-- プレビュー表示用 -->
        <div id="preview"></div>
      </li>
    </ul>
  <% end %>

</div>