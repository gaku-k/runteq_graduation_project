<% images = post.images %>
<% case images.size %>
<% when 1 %>
  <!-- 1枚: div class="w-full" で全幅を使用 -->
  <div class="w-full">
    <%= image_tag images.first.variant(resize_to_fill: [600, 800]).processed %>
  </div>

<% when 2 %>
  <!-- 2枚: 横に2分割 -->
  <div class="grid grid-cols-2">
    <% images.each do |img| %>
      <div>
        <%= image_tag img.variant(resize_to_fill: [300, 400]).processed %>
      </div>
    <% end %>
  </div>

<% when 3 %>
  <!-- 3枚: 左1枚(50%) + 右上下2分割 -->
  <div class="grid grid-cols-2">
    <!-- 左 (1枚) -->
    <div>
      <%= image_tag images[0].variant(resize_to_fill: [400, 600]).processed %>
    </div>
    <!-- 右 (上下2分割) -->
    <div class="grid grid-rows-2">
      <%= image_tag images[1].variant(resize_to_fill: [400, 300]).processed %>
      <%= image_tag images[2].variant(resize_to_fill: [400, 300]).processed %>
    </div>
  </div>

<% when 4 %>
  <!-- 4枚: 2×2 グリッド -->
  <div class="grid grid-cols-2">
    <% images.each do |img| %>
      <div>
        <%= image_tag img.variant(resize_to_fill: [400, 300]).processed %>
      </div>
    <% end %>
  </div>
<% end %>