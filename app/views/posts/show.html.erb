<div class="my-card">
  <div class="posts-list">
    <div class="avatar-post-wrapper">
      <div>
        <% if @post.user.avatar.attached? %>
          <%= image_tag @post.user.avatar.variant(resize_to_fill: [300, 300]),
            class: "rounded-full user-avatar-s"%>
        <% else %>
          <%= image_tag "44775.jpg",
            class: "rounded-full user-avatar-s" %>
        <% end %>
      </div>
      
      <div class="post-item">
        <div class="image-section">
          <%= render "images", post: @post %>
        </div>

        <div class="chart-review-wrapper"> 
          <div class="chart-section">

              <% if @post.product_id.present? %>
                <%= link_to @post.product_name, product_path(@post.product_id) %>

                <% product_rating = @post.product.product_ratings.find_by(user: @post.user) %>
                <% if product_rating.present? %>
                  <%= render partial: "posts/triangle_chart", locals: { product_rating: product_rating } %>
                <% end %>
              <% else %>
                <%= @post.product_name %>
              <% end %>
              
          </div>

          <div class="review-section"> 
            <p><%= @post.body %></p>
          </div>
        </div>
        
      </div>
    </div>
  </div>

  <div class="reaction-container">
    <% if @post.user == current_user %>
      <%= link_to post_path(@post.id),method: :delete, data: { confirm: "削除しますか？" }, class: "trash-can" do %>
        <i class="fas fa-trash"></i>
      <% end %>
    <% end %>
  </div>
</div>