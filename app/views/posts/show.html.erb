<div class="my-card">
  <div class="posts-list">
    <div class="avatar-post-wrapper">

      <div>
        <%= link_to user_path(@post.user) do %>
          <% if @post.user.avatar.attached? %>
            <%= image_tag @post.user.avatar.variant(resize_to_fill: [300, 300]),
              class: "rounded-full user-avatar-s"%>
          <% else %>
            <%= image_tag "44775.jpg",
              class: "rounded-full user-avatar-s" %>
          <% end %>
        <% end %>
      </div>
      
      <div class="post-item">
        <div class="image-section">
          <%= render "images", post: @post %>
        </div>

        <div class="chart-review-wrapper"> 
          <% if @post.product_id.present? %>
            <div class="chart-section">
              <%= link_to @post.product_name, product_path(@post.product_id), class: "productname-link"%>

              <% product_rating = @post.product.product_ratings.find_by(user: @post.user) %>
              <% if product_rating.present? %>
                <%= render partial: "posts/triangle_chart", locals: { post_id: @post.id, product_rating: product_rating } %>
              <% end %>
            </div>
          <% end %>

          <div class="review-section"> 
            <p><%= @post.body %></p>
          </div>
        </div>
        
      </div>
    </div>
  </div>

  <div class="reaction-container">
    <div class="like-wrapper">
      <% if user_signed_in? && current_user.liked_post?(@post) %>
        <%= button_to post_like_posts_path(@post), method: :delete do %>
          <i class="fa-solid fa-heart"></i>
        <% end %>
      <% else %>
        <%= button_to post_like_posts_path(@post), method: :post do %>
          <i class="fa-regular fa-heart"></i>
        <% end %>
      <% end %>
      <%= @post.like_posts.count %>
    </div>

    <% if @post.user == current_user %>
      <%= button_to post_path(@post.id), method: :delete, data: { confirm: "削除しますか？" }, class: "trash-can" do %>
        <i class="fas fa-trash"></i>
      <% end %>
    <% end %>
  </div>

  <div>コメント</div>
  <%= render "comments/form", commentable: @post %>

  <% @comments.each do |comment| %>
    <%= render "comments/comment",
      comment: comment,
      commentable: @post
    %>
  <% end %>
</div>