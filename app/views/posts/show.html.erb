<div class="my-card">
  <h1>投稿詳細</h1>

  <ul class="posts-list">
      <li class="post-item">
        <div class="image-section">
          <%= render "images", post: @post %>
        </div>

        <div class="chart-review-wrapper"> 
          <div class="chart-section">
            <h2 class="post-title">
              <% if @post.product_id.present? %>
                <%= link_to @post.product_name, product_path(@post.product_id) %>
              <% else %>
                <%= @post.product_name %>
              <% end %>
            </h2>
            <%= render partial: "radar_chart", locals: { post: @post } %>
          </div>

          <div class="review-section">
            <article>
              <h2 class="post-title italic-title">Review</h2>
              <p><%= @post.body %></p>
            </article>
          </div>
        </div>
        <div>
          <% if @post.user == current_user %>
            <%= link_to post_path(@post.id),method: :delete, data: { confirm: "削除しますか？" } do %>
              <i class="fas fa-trash"></i>
            <% end %>
          <% end %>
        <div>
      </li>
  </ul>
</div>