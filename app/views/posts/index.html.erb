<%= render "shared/floating_button" %>
<%= render "shared/admin_floating_button" %>

<!-- 背景画像セクション -->
<div class="relative left-1/2 right-1/2 -mx-[50vw] w-screen bg-cover bg-center bg-no-repeat pt-12 sm:pt-16 pb-5"
     style="background-image: url(<%= asset_path('lucio-patone-Gt4FnWPbjfo-unsplash.jpg') %>);">

  <!-- キャッチコピー -->
  <h2 class="text-white text-xl sm:text-2xl font-semibold text-center mb-6 drop-shadow-lg px-[80px]">
    レビューから広がる、あなただけの愛用品
  </h2>

  <div data-controller="autocomplete">
 
    <!-- 検索フォーム -->
    <%= render "shared/search_form",
      q: @q,
      url: posts_path,
      search_key: :product_name_or_body_cont %>

    <%= turbo_frame_tag "search_results" do %>
      <!-- 検索候補:オートコンプリートは商品名にのみ実装 -->
      <!-- 左: フォームが送信されたか.右: valuesでハッシュを値だけの配列にし、一文字でも入力があればtrue( .any? { |v| v.present? } )。空文字の場合右の処理へ進む -->
      <% if params[:q].present? && params[:q].values.any?(&:present?) %>
        <% @suggestions.each do |s| %>
          <div
            data-action="click->autocomplete#select"
            data-value="<%= s.product_name %>">
            <%= s.product_name %>
          </div>
        <% end %>
      <% end %>
    <% end %>

  </div>
</div>

<%= turbo_frame_tag "posts_list" do %>
  <div class="my-card">
    <div class="posts-list">
      <% @posts.each do |post| %>
        <div class="avatar-post-wrapper">

          <div>
            <%= link_to user_path(post.user), data: { turbo_frame: "_top" } do %>
              <% if post.user.avatar.attached? %>
                <%= image_tag post.user.avatar.variant(resize_to_fill: [300, 300]),
                  class: "rounded-full user-avatar-s"%>
              <% else %>
                <%= image_tag "44775.jpg",
                  class: "rounded-full user-avatar-s" %>
              <% end %>
            <% end %>
          </div>
    
          <div class="post-item">
            <%= link_to post_path(post), class: "post-card-link", data: { turbo_frame: "_top" } do %>
              <div class="image-section">
                <%= render "posts/images", post: post %>
              </div>

              <div class="chart-review-wrapper">
    
                <% if post.product.present? %>
                  <!-- 1ユーザー1商品1評価値を実現するためにProductRatingsテーブルにはpost_idがない。つなりPostと直接的なアソシエーションがない -->
                  <% product_rating = post.product.product_ratings.find_by(user: post.user) %>
                  <% if product_rating.present? %>
                    <div class="chart-section">
                      <h2><%= post.product_name %></h2>
                      <%= render partial: "posts/triangle_chart", locals: { post_id: post.id, product_rating: product_rating } %>
                    </div>
                  <% end %>
                <% end %>              

                <div class="review-section">
                  <p class="review-body"><%= post.body %></p>
                </div>

                <div class="reaction-container">
                  <div class="like-wrapper">
                    <% if user_signed_in? && current_user.liked_post?(post) %>
                      <%= button_to post_like_posts_path(post), method: :delete do %>
                        <i class="fa-solid fa-heart"></i>
                      <% end %>
                    <% else %>
                      <%= button_to post_like_posts_path(post), method: :post do %>
                        <i class="fa-regular fa-heart"></i>
                      <% end %>
                    <% end %>
                    <%= post.like_posts.count %>
                  </div>

                  <% if post.user == current_user %>
                    <%= button_to post_path(post.id),
                        method: :delete,
                        data: { turbo_confirm: "削除しますか？", turbo_frame: "_top" },
                        class: "trash-can" do %>
                      <i class="fas fa-trash"></i>
                    <% end %>
                  <% end %>
                </div>

              </div>
            <!-- link_to のend -->
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="pagination">
    <%= paginate @posts %>
  </div>
<% end %>