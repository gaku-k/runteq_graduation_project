<%= render "shared/floating_button" %>
<%= render "shared/admin_floating_button" %>

<!-- 背景画像セクション -->
<div class="relative left-1/2 right-1/2 -mx-[50vw] w-screen bg-cover bg-center bg-no-repeat pt-12 sm:pt-16 container-spacing"
     style="background-image: url(<%= asset_path('lucio-patone-Gt4FnWPbjfo-unsplash.jpg') %>);">

  <!-- キャッチコピー -->
  <h2 class="custom-white-text text-xl sm:text-2xl font-semibold text-center mb-6 drop-shadow-lg px-[80px]">
    レビューから広がる、あなただけの愛用品
  </h2>

  <!-- 検索フォーム中央寄せ -->
  <%= search_form_for @q, url: posts_path, method: :get, class: "flex justify-center" do |f| %>
    <div class="flex w-[90%] max-w-[400px] sm:max-w-[700px]">
      <%= f.search_field :product_name_or_body_cont,
        placeholder: "キーワードを入力",
        class: "w-full p-2 border border-gray-300 rounded-l-lg focus:outline-none focus:ring-1" %>
      <%= f.submit "検索",
        class: "search-submit-button px-4 py-2 rounded-r-lg" %>
    </div>
  <% end %>
</div>
<br>

<div class="my-card">
  <ul class="posts-list">
    <% @posts.each do |post| %>
      <li class="post-item">
        <%= link_to post_path(post), class: "post-card-link" do %>
          <div class="image-section">
            <%= render "posts/images", post: post %>
          </div>

          <div class="chart-review-wrapper">
            <div class="chart-section">
              <h2 class="post-title"><%= post.product_name %></h2>
              <%= render partial: "posts/radar_chart", locals: { post: post } %>
            </div>

            <div class="review-section">
              <article>
                <h2 class="post-title italic-title">Review</h2>
                <p><%= post.body %></p>
              </article>
            </div>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>